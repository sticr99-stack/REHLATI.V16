# رحلتي — Rehlati متغيرات البيئة
# انسخ هذا الملف إلى .env ثم ضع قيماً حقيقية:   cp .env.example .env
# ⚠️ ملف .env لا يُرفع أبداً إلى GitHub (مستثنى في .gitignore) — على Vercel ضع القيم في Project Settings → Environment Variables

# ── قاعدة البيانات ─────────────────────────────────────────────
# محلياً / على VPS بـ Docker: SQLite كافية (افتراضي)
DATABASE_URL=file:./db/custom.db
# على Vercel: نظام الملفات مؤقت → استخدم Postgres مجاني من neon.tech
# 1) في prisma/schema.prisma غيّر:  provider = "postgresql"
# 2) هنا أو في Vercel ضع رابط Neon:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── أمن الجلسات (إلزامي في الإنتاج) ───────────────────────────
# أنشئ سراً قوياً بأمر:  openssl rand -hex 32
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32

# ── Duffel — الرحلات الحقيقية (البديل الموصى به) ────────────────
# ⚠️ بوابة Amadeus Self-Service أُغلقت نهائياً في 17 يوليو 2026 — استخدم Duffel
# 1) سجّل مجاناً في دقيقة: https://duffel.com  (Sign up → تأكيد البريد)
# 2) لوحة التحكم → Developers → API tokens → انسخ Test token (يبدأ بـ duffel_test_)
# 3) ضعه هنا (محلياً) أو في متغيرات Vercel — بدون توكن يعمل محرك المحاكاة الداخلي
DUFFEL_API_TOKEN=

# ── Amadeus Enterprise (لأصحاب العقود فقط — التسجيل الذاتي المجاني أُغلق) ──
# المفاتيح القديمة عُطّلت. لا تعمل إلا إذا كان لديك عقد Enterprise مع أماديوس.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# بيئة أماديوس:  test = افتراضي | production = api.amadeus.com
AMADEUS_HOSTNAME=test
