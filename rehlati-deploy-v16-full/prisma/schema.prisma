// رحلتي — Rehlati Database Schema
// SQLite (تطوير/صندوق رملي) — يمكن التبديل إلى postgres بتغيير provider + DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// مستخدم مسجّل (تسجيل الدخول من صفحة sign-in)
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String // scrypt hash: salt:hex
  lang         String    @default("ar")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

// حجز (طيران / فندق / باقة) — نفس شكل كائن rehlati_trips في الواجهة
model Booking {
  id         String    @id @default(cuid())
  ref        String    @unique // FLT-XXXXXX / HTL-XXXXXX / PKG-XXXXXX
  type       String // flight | hotel | package
  email      String // بريد صاحب الحجز (فهرس للبحث)
  userId     String?
  device     String    @default("") // معرّف الجهاز — يمنع تعداد حجوزات الغير
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title      String    @default("") // وصف مختصر: المسار أو الفندق أو الباقة
  totalMad   Float     @default(0) // السعر الأساسي بالدرهم (MAD أساس)
  cur        String    @default("MAD")
  status     String    @default("confirmed") // confirmed | cancelled
  lang       String    @default("ar")
  visa       Boolean   @default(false)
  payload    String    @default("{}") // JSON كامل مطابق لكائن الواجهة (rehydrate متاح)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([type])
  @@index([createdAt])
}

// سجل محاولات الدخول الفاشلة (تحصين ضد التخمين)
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String   @default("")
  ok        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
